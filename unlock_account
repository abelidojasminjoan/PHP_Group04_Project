<?php

/* =========================================================
   LOAD CONFIGURATION
========================================================= */

require_once __DIR__ . '/../../../config/app.php';
require_once __DIR__ . '/../../../config/db.php';


/* =========================================================
   ONLY ALLOW POST
========================================================= */

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {

    header(
        'Location: '
            . BASE_URL
            . '/admin/security/settings.php'
    );

    exit;
}


/* =========================================================
   GET USER ID
========================================================= */

$userId = (int) ($_POST['user_id'] ?? 0);


/* =========================================================
   VALIDATE USER
========================================================= */

if ($userId <= 0) {

    $_SESSION['security_error'] =
        'Invalid user account.';

    header(
        'Location: '
            . BASE_URL
            . '/admin/security/settings.php'
    );

    exit;
}


/* =========================================================
   UNLOCK USER ACCOUNT
========================================================= */

$stmt = $conn->prepare("
    UPDATE users
    SET
        status = 'active',
        failed_login_attempts = 0,
        locked_until = NULL
    WHERE id = ?
");


/* =========================================================
   BIND USER ID
========================================================= */

$stmt->bind_param(
    'i',
    $userId
);


/* =========================================================
   SAVE CHANGES
========================================================= */

if ($stmt->execute()) {

    $_SESSION['security_success'] =
        'Account unlocked successfully.';
} else {

    $_SESSION['security_error'] =
        'Unable to unlock account.';
}


/* =========================================================
   CLOSE STATEMENT
========================================================= */

$stmt->close();


/* =========================================================
   RETURN TO SECURITY SETTINGS
========================================================= */

header(
    'Location: '
        . BASE_URL
        . '/admin/security/settings.php'
);

exit;
